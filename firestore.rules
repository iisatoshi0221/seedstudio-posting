    match /userSchedulePlans/{recordId} {
      function schedulePermitted(d) {
        return isActiveMealStaff()
          && recordId == d.userId + '-' + d.date
          && d.userId.matches('^U[0-9]{4}$')
          && liveDate(d.date)
          && liveTarget(d.userId, d.date);
      }

      function scheduleValue(value) {
        return value in [
          'onsite',
          'home',
          'off',
          'undecided'
        ];
      }

      function scheduleSlotValue(value) {
        return value in [
          'full',
          'am',
          'pm'
        ];
      }

      function scheduleSlot(d) {
        return d.get(
          'attendanceSlot',
          d.plannedAttendance == 'onsite'
            ? 'full'
            : null
        );
      }

      function scheduleSlotValid(d) {
        return (
            d.plannedAttendance == 'onsite'
            && scheduleSlotValue(
              d.attendanceSlot
            )
          )
          || (
            d.plannedAttendance in [
              'home',
              'off',
              'undecided'
            ]
            && d.attendanceSlot == null
          );
      }

      function scheduleBeforeSlotValid(
        before,
        beforeAttendanceSlot
      ) {
        return (
            before == null
            && beforeAttendanceSlot == null
          )
          || (
            before == 'onsite'
            && scheduleSlotValue(
              beforeAttendanceSlot
            )
          )
          || (
            before in [
              'home',
              'off',
              'undecided'
            ]
            && beforeAttendanceSlot == null
          );
      }

      function parentValid(d) {
        return d.keys().hasAll([
            'userId',
            'date',
            'plannedAttendance',
            'attendanceSlot',
            'version',
            'actor',
            'operationId',
            'updatedAt'
          ])
          && d.keys().hasOnly([
            'userId',
            'date',
            'plannedAttendance',
            'attendanceSlot',
            'version',
            'actor',
            'operationId',
            'updatedAt'
          ])
          && d.userId is string
          && d.date is string
          && scheduleValue(
            d.plannedAttendance
          )
          && scheduleSlotValid(d)
          && d.version is int
          && d.version > 0
          && d.actor == request.auth.uid
          && d.operationId is string
          && d.operationId.matches(
            '^[a-zA-Z0-9-]{1,80}$'
          )
          && d.updatedAt == request.time
          && schedulePermitted(d);
      }

      function linkedHistory(d) {
        let path =
          /databases/$(database)/documents/userSchedulePlans/$(recordId)/history/$(d.operationId);

        let next =
          getAfter(path).data;

        return !exists(path)
          && next.userId == d.userId
          && next.date == d.date
          && next.plannedAttendance
             == d.plannedAttendance
          && next.attendanceSlot
             == d.attendanceSlot
          && next.version
             == d.version
          && next.actor
             == d.actor
          && next.operationId
             == d.operationId
          && next.updatedAt
             == d.updatedAt;
      }

      allow get, list:
        if isActiveMealStaff();

      allow create:
        if parentValid(
          request.resource.data
        )
        && request.resource.data.version == 1
        && linkedHistory(
          request.resource.data
        );

      allow update:
        if parentValid(
          request.resource.data
        )
        && request.resource.data.version
           == resource.data.version + 1
        && (
          request.resource.data.plannedAttendance
            != resource.data.plannedAttendance
          || request.resource.data.attendanceSlot
            != scheduleSlot(resource.data)
        )
        && linkedHistory(
          request.resource.data
        );

      allow delete: if false;

      match /history/{operationId} {
        function historyValid(d) {
          return d.keys().hasAll([
              'userId',
              'date',
              'before',
              'beforeAttendanceSlot',
              'plannedAttendance',
              'attendanceSlot',
              'version',
              'reason',
              'actor',
              'operationId',
              'updatedAt'
            ])
            && d.keys().hasOnly([
              'userId',
              'date',
              'before',
              'beforeAttendanceSlot',
              'plannedAttendance',
              'attendanceSlot',
              'version',
              'reason',
              'actor',
              'operationId',
              'updatedAt'
            ])
            && d.userId is string
            && d.userId.matches(
              '^U[0-9]{4}$'
            )
            && d.date is string
            && liveDate(d.date)
            && scheduleValue(
              d.plannedAttendance
            )
            && scheduleSlotValid(d)
            && (
              d.before == null
              || scheduleValue(
                d.before
              )
            )
            && scheduleBeforeSlotValid(
              d.before,
              d.beforeAttendanceSlot
            )
            && d.version is int
            && d.version > 0
            && d.reason is string
            && d.reason.size() <= 200
            && d.actor
               == request.auth.uid
            && d.operationId
               == operationId
            && d.operationId.matches(
              '^[a-zA-Z0-9-]{1,80}$'
            )
            && d.updatedAt
               == request.time
            && liveTarget(
              d.userId,
              d.date
            );
        }

        function linkedParent() {
          let path =
            /databases/$(database)/documents/userSchedulePlans/$(recordId);

          let next =
            getAfter(path).data;

          return historyValid(
              request.resource.data
            )
            && recordId
               == request.resource.data.userId
                  + '-'
                  + request.resource.data.date
            && next.userId
               == request.resource.data.userId
            && next.date
               == request.resource.data.date
            && next.plannedAttendance
               == request.resource.data.plannedAttendance
            && next.attendanceSlot
               == request.resource.data.attendanceSlot
            && next.version
               == request.resource.data.version
            && next.actor
               == request.resource.data.actor
            && next.operationId
               == request.resource.data.operationId
            && next.updatedAt
               == request.resource.data.updatedAt
            && (
              (
                !exists(path)
                && next.version == 1
                && request.resource.data.before == null
                && request.resource.data.beforeAttendanceSlot
                   == null
                && request.resource.data.reason == ''
              )
              || (
                exists(path)
                && next.version
                   == get(path).data.version + 1
                && request.resource.data.before
                   == get(path).data.plannedAttendance
                && request.resource.data.beforeAttendanceSlot
                   == scheduleSlot(
                     get(path).data
                   )
                && request.resource.data.reason.matches(
                  '(?s).*[^\\s].*'
                )
              )
            );
        }

        allow read:
          if isActiveMealStaff();

        allow create:
          if linkedParent();

        allow update, delete:
          if false;
      }
    }

    /*
     * ---------------------------------------------------------
     * Daily operation plans
     *
     * 鄙悟霧讌ｭ譌･縺ｮ讌ｭ蜍呎ｺ門ｙ
     * - 陦後″騾∬ｿ・
     * - 蟶ｰ繧企∬ｿ・
     * - 譏ｼ鬟・
     *
     * 譛磯俣莠亥ｮ壹′ onsite 縺ｮ蛻ｩ逕ｨ閠・□縺台ｿ晏ｭ倥〒縺阪ｋ縲・
     * parent + history 繧貞酔縺・rite縺ｧ菴懈・縺吶ｋ縲・
     * ---------------------------------------------------------
     */

    function operationPlanStaff() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.role in [
          'admin',
          'support'
        ];
    }

    function operationPlanValue(value) {
      return value in [
        'yes',
        'no',
        'undecided'
      ];
    }

    function operationPlanOperationId(value) {
      return value is string
        && value.matches(
          '^[A-Za-z0-9-]{1,80}$'
        );
    }

    function operationPlanUserId(value) {
      return value is string
        && value.matches(
          '^U[0-9]{4}$'
        );
    }

    function operationPlanDate(value) {
      return value is string
        && value.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        );
    }

    function operationPlanRecordId(
      recordId,
      data
    ) {
      return operationPlanUserId(
          data.userId
        )
        && operationPlanDate(
          data.date
        )
        && recordId
          == data.userId
          + '-'
          + data.date;
    }

    function operationPlanContractOk(
      data
    ) {
      let user =
        get(
          /databases/$(database)/documents/users/$(data.userId)
        );

      return user != null
        && user.data.startDate
          <= data.date
        && (
          user.data.endDate == null
          || data.date
            <= user.data.endDate
        );
    }

    function operationPlanBusinessDayOk(
      data
    ) {
      return exists(
          /databases/$(database)/documents/businessDays/$(data.date)
        )
        && get(
          /databases/$(database)/documents/businessDays/$(data.date)
        ).data.open == true;
    }

    function operationPlanScheduleOk(
      recordId
    ) {
      return exists(
          /databases/$(database)/documents/userSchedulePlans/$(recordId)
        )
        && get(
          /databases/$(database)/documents/userSchedulePlans/$(recordId)
        ).data.plannedAttendance
          == 'onsite';
    }

    function operationPlanTargetOk(
      recordId,
      data
    ) {
      return operationPlanRecordId(
          recordId,
          data
        )
        && operationPlanContractOk(
          data
        )
        && operationPlanBusinessDayOk(
          data
        )
        && operationPlanScheduleOk(
          recordId
        );
    }

    function operationPlanParentKeys(
      data
    ) {
      return data.keys().hasOnly([
        'userId',
        'date',
        'pickupOut',
        'pickupBack',
        'meal',
        'version',
        'actor',
        'operationId',
        'updatedAt'
      ]);
    }

    function operationPlanParentCommon(
      recordId,
      data
    ) {
      return operationPlanParentKeys(
          data
        )
        && operationPlanTargetOk(
          recordId,
          data
        )
        && operationPlanValue(
          data.pickupOut
        )
        && operationPlanValue(
          data.pickupBack
        )
        && operationPlanValue(
          data.meal
        )
        && data.version is int
        && data.version >= 1
        && data.actor
          == request.auth.uid
        && operationPlanOperationId(
          data.operationId
        )
        && data.updatedAt
          == request.time;
    }

    function operationPlanChanged(
      oldData,
      newData
    ) {
      return oldData.pickupOut
          != newData.pickupOut
        || oldData.pickupBack
          != newData.pickupBack
        || oldData.meal
          != newData.meal;
    }

    function operationPlanLinkedHistory(
      recordId,
      data
    ) {
      let history =
        getAfter(
          /databases/$(database)/documents/dailyOperationPlans/$(recordId)/history/$(data.operationId)
        );

      return history != null
        && history.data.userId
          == data.userId
        && history.data.date
          == data.date
        && history.data.pickupOut
          == data.pickupOut
        && history.data.pickupBack
          == data.pickupBack
        && history.data.meal
          == data.meal
        && history.data.version
          == data.version
        && history.data.actor
          == data.actor
        && history.data.operationId
          == data.operationId
        && history.data.updatedAt
          == request.time;
    }

    match /dailyOperationPlans/{recordId} {
      allow get, list:
        if operationPlanStaff();

      allow create:
        if operationPlanStaff()
        && operationPlanParentCommon(
          recordId,
          request.resource.data
        )
        && request.resource.data.version
          == 1
        && operationPlanLinkedHistory(
          recordId,
          request.resource.data
        );

      allow update:
        if operationPlanStaff()
        && operationPlanParentCommon(
          recordId,
          request.resource.data
        )
        && request.resource.data.userId
          == resource.data.userId
        && request.resource.data.date
          == resource.data.date
        && request.resource.data.version
          == resource.data.version + 1
        && operationPlanChanged(
          resource.data,
          request.resource.data
        )
        && operationPlanLinkedHistory(
          recordId,
          request.resource.data
        );

      allow delete:
        if false;

      match /history/{operationId} {
        allow get, list:
          if operationPlanStaff();

        function operationPlanHistoryKeys(
          data
        ) {
          return data.keys().hasOnly([
            'userId',
            'date',
            'pickupOut',
            'pickupBack',
            'meal',
            'before',
            'version',
            'actor',
            'operationId',
            'reason',
            'updatedAt'
          ]);
        }

        function operationPlanHistoryCommon(
          data
        ) {
          return operationPlanHistoryKeys(
              data
            )
            && operationPlanRecordId(
              recordId,
              data
            )
            && operationPlanTargetOk(
              recordId,
              data
            )
            && operationPlanValue(
              data.pickupOut
            )
            && operationPlanValue(
              data.pickupBack
            )
            && operationPlanValue(
              data.meal
            )
            && data.version is int
            && data.version >= 1
            && data.actor
              == request.auth.uid
            && data.operationId
              == operationId
            && operationPlanOperationId(
              data.operationId
            )
            && data.reason is string
            && data.reason.size()
              <= 500
            && data.updatedAt
              == request.time;
        }

        function operationPlanInitialHistory(
          data
        ) {
          return data.version == 1
            && data.before == null
            && data.reason == '';
        }

        function operationPlanCorrectionBefore(
          data
        ) {
          let oldParent =
            resource == null
              ? null
              : resource.data;

          let previous =
            get(
              /databases/$(database)/documents/dailyOperationPlans/$(recordId)
            );

          return previous != null
            && data.version
              == previous.data.version + 1
            && data.before is map
            && data.before.keys().hasOnly([
              'pickupOut',
              'pickupBack',
              'meal'
            ])
            && data.before.pickupOut
              == previous.data.pickupOut
            && data.before.pickupBack
              == previous.data.pickupBack
            && data.before.meal
              == previous.data.meal
            && data.reason.size()
              > 0;
        }

        function operationPlanLinkedParent(
          data
        ) {
          let parent =
            getAfter(
              /databases/$(database)/documents/dailyOperationPlans/$(recordId)
            );

          return parent != null
            && parent.data.userId
              == data.userId
            && parent.data.date
              == data.date
            && parent.data.pickupOut
              == data.pickupOut
            && parent.data.pickupBack
              == data.pickupBack
            && parent.data.meal
              == data.meal
            && parent.data.version
              == data.version
            && parent.data.actor
              == data.actor
            && parent.data.operationId
              == data.operationId
            && parent.data.updatedAt
              == request.time;
        }

        allow create:
          if operationPlanStaff()
          && operationPlanHistoryCommon(
            request.resource.data
          )
          && (
            operationPlanInitialHistory(
              request.resource.data
            )
            ||
            operationPlanCorrectionBefore(
              request.resource.data
            )
          )
          && operationPlanLinkedParent(
            request.resource.data
          );

        allow update, delete:
          if false;
      }
    }



    // ============================================================
// SeedStudio Posting
// Posting Records v2
//
// SP-Next-2C-2
//
// Compatibility:
// - Existing v0.1 create remains accepted during the staged rollout.
// - Legacy records without status/version are treated as active/version 1
//   when they are first edited.
// - Physical delete is always denied.
// ============================================================

match /postingRecords/{postingId} {

  function postingOperationId(value) {
    return value is string
      && value.matches('^posting-[A-Za-z0-9-]{1,120}$');
  }

  function postingStatus(data) {
    return data.get('status', 'active');
  }

  function postingVersion(data) {
    return data.get('version', 1);
  }

  function postingBusinessFieldsValid(data) {
    return data.id == postingId
      && data.postingDate is string
      && data.staffId is string
      && data.flyerId is string
      && data.quantity is int
      && data.quantity > 0
      && data.participants is list
      && data.participants.size() > 0
      && data.area is map
      && data.createdAt is string
      && data.createdByUid is string
      && data.createdByEmail is string;
  }

  function postingV2Keys(data) {
    return data.keys().hasAll([
        'id',
        'postingDate',
        'staffId',
        'flyerId',
        'quantity',
        'participants',
        'area',
        'createdAt',
        'createdByUid',
        'createdByEmail',
        'status',
        'version',
        'operationId',
        'updatedAt',
        'updatedByUid',
        'deletedAt',
        'deletedByUid',
        'deleteReason',
        'deleteComment'
      ])
      && data.keys().hasOnly([
        'id',
        'postingDate',
        'staffId',
        'flyerId',
        'quantity',
        'participants',
        'area',
        'createdAt',
        'createdByUid',
        'createdByEmail',
        'status',
        'version',
        'operationId',
        'updatedAt',
        'updatedByUid',
        'deletedAt',
        'deletedByUid',
        'deleteReason',
        'deleteComment'
      ]);
  }

  function postingLegacyCreate(data) {
    return data.keys().hasAll([
        'id',
        'postingDate',
        'staffId',
        'flyerId',
        'quantity',
        'participants',
        'area',
        'createdAt',
        'createdByUid',
        'createdByEmail'
      ])
      && data.keys().hasOnly([
        'id',
        'postingDate',
        'staffId',
        'flyerId',
        'quantity',
        'participants',
        'area',
        'createdAt',
        'createdByUid',
        'createdByEmail'
      ])
      && postingBusinessFieldsValid(data)
      && data.createdByUid == request.auth.uid;
  }

  function postingSnapshot(data) {
    return {
      'postingDate': data.postingDate,
      'staffId': data.staffId,
      'flyerId': data.flyerId,
      'quantity': data.quantity,
      'participants': data.participants,
      'area': data.area
    };
  }

  function postingLogPath(operationId) {
    return /databases/$(database)/documents/postingRecords/$(postingId)/changeLogs/$(operationId);
  }

  function postingLinkedLog(next, action, beforeVersion) {
    let path = postingLogPath(next.operationId);
    let log = getAfter(path).data;

    return !exists(path)
      && log.action == action
      && log.versionBefore == beforeVersion
      && log.versionAfter == next.version
      && log.before == postingSnapshot(resource.data)
      && log.after == postingSnapshot(next)
      && log.actorUid == request.auth.uid
      && log.operationId == next.operationId
      && log.changedAt == request.time
      && (
        action != 'delete'
        || (
          log.reason == next.deleteReason
          && log.get('comment', '') == next.deleteComment
        )
      );
  }

  // SeedStudio active admin/support may read Posting records.
  allow get, list:
    if isActiveMealStaff();

  // Staged rollout:
  // keep current v0.1 create path working until the client create path
  // is migrated to v2 in a later phase.
  allow create:
    if isActiveMealStaff()
      && postingLegacyCreate(request.resource.data);

  // Ordinary edit:
  // admin/support, active record only, immutable creation metadata,
  // strict +1 version, and an atomic immutable changeLog.
  allow update:
    if isActiveMealStaff()

      && postingStatus(resource.data) == 'active'
      && postingStatus(request.resource.data) == 'active'

      && postingV2Keys(request.resource.data)
      && postingBusinessFieldsValid(request.resource.data)

      && request.resource.data.id == resource.data.id
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.createdByUid == resource.data.createdByUid
      && request.resource.data.createdByEmail == resource.data.createdByEmail

      && request.resource.data.version
        == postingVersion(resource.data) + 1

      && postingOperationId(request.resource.data.operationId)

      && request.resource.data.updatedByUid == request.auth.uid
      && request.resource.data.updatedAt == request.time

      && request.resource.data.deletedAt == null
      && request.resource.data.deletedByUid == null
      && request.resource.data.deleteReason == ''
      && request.resource.data.deleteComment == ''

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'postingDate',
          'staffId',
          'flyerId',
          'quantity',
          'participants',
          'area'
        ])

      && postingLinkedLog(
        request.resource.data,
        'update',
        postingVersion(resource.data)
      );

  // Logical delete is represented by an update and is admin-only.
  allow update:
    if isActiveAdmin()

      && postingStatus(resource.data) == 'active'
      && postingStatus(request.resource.data) == 'deleted'

      && postingV2Keys(request.resource.data)
      && postingBusinessFieldsValid(request.resource.data)

      && request.resource.data.id == resource.data.id
      && request.resource.data.postingDate == resource.data.postingDate
      && request.resource.data.staffId == resource.data.staffId
      && request.resource.data.flyerId == resource.data.flyerId
      && request.resource.data.quantity == resource.data.quantity
      && request.resource.data.participants == resource.data.participants
      && request.resource.data.area == resource.data.area
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.createdByUid == resource.data.createdByUid
      && request.resource.data.createdByEmail == resource.data.createdByEmail

      && request.resource.data.version
        == postingVersion(resource.data) + 1

      && postingOperationId(request.resource.data.operationId)

      && request.resource.data.updatedByUid == request.auth.uid
      && request.resource.data.updatedAt == request.time

      && request.resource.data.deletedAt == request.time
      && request.resource.data.deletedByUid == request.auth.uid
      && request.resource.data.deleteReason is string
      && request.resource.data.deleteReason.matches('(?s).*[^\\s].*')
      && request.resource.data.deleteReason.size() <= 200
      && request.resource.data.deleteComment is string
      && request.resource.data.deleteComment.size() <= 500

      && postingLinkedLog(
        request.resource.data,
        'delete',
        postingVersion(resource.data)
      );

  // Never physically delete Posting history.
  allow delete:
    if false;


  match /changeLogs/{operationId} {

    function postingChangeLogCommon(data) {
      return data.keys().hasAll([
          'action',
          'versionBefore',
          'versionAfter',
          'before',
          'after',
          'reason',
          'actorUid',
          'actorEmail',
          'operationId',
          'changedAt'
        ])
        && data.keys().hasOnly([
          'action',
          'versionBefore',
          'versionAfter',
          'before',
          'after',
          'reason',
          'comment',
          'actorUid',
          'actorEmail',
          'operationId',
          'changedAt'
        ])
        && data.action in ['update', 'delete']
        && data.versionBefore is int
        && data.versionBefore >= 1
        && data.versionAfter == data.versionBefore + 1
        && data.before is map
        && data.after is map
        && data.reason is string
        && data.reason.size() <= 500
        && data.actorUid == request.auth.uid
        && data.actorEmail is string
        && data.operationId == operationId
        && postingOperationId(data.operationId)
        && data.changedAt == request.time;
    }

    function postingChangeLogLinkedParent(data) {
      let parentPath =
        /databases/$(database)/documents/postingRecords/$(postingId);

      let next =
        getAfter(parentPath).data;

      return next.operationId == data.operationId
        && next.version == data.versionAfter
        && next.updatedByUid == data.actorUid
        && next.updatedAt == request.time
        && data.after == postingSnapshot(next)
        && data.before == postingSnapshot(get(parentPath).data);
    }

    allow get, list:
      if isActiveMealStaff();

    allow create:
      if isActiveMealStaff()
        && postingChangeLogCommon(request.resource.data)
        && postingChangeLogLinkedParent(request.resource.data);

    allow update, delete:
      if false;
  }
}



    // ============================================================
    // SeedStudio Posting - participant settings
    // ============================================================
    // SSS の共通利用者 / Person マスターを正本とし、
    // Posting 側には「参加候補として表示するか」だけを保持する。
    // 氏名・在籍状態などはここには複製しない。
    // ============================================================

    match /postingParticipants/{personId} {

      // 有効な SeedStudio 職員のみ閲覧可
      allow get, list:
        if isActiveMealStaff();

      // 初回追加
      allow create:
        if isActiveMealStaff()

        && request.resource.data.keys().hasAll([
          'personId',
          'enabled',
          'addedAt',
          'addedByUid',
          'updatedAt',
          'updatedByUid'
        ])

        && request.resource.data.keys().hasOnly([
          'personId',
          'enabled',
          'addedAt',
          'addedByUid',
          'updatedAt',
          'updatedByUid'
        ])

        // Document ID と personId を一致させる
        && request.resource.data.personId == personId
        && request.resource.data.personId is string
        && request.resource.data.personId.size() >= 1
        && request.resource.data.personId.size() <= 100

        // Posting 参加対象かどうか
        && request.resource.data.enabled is bool

        // 初回登録者・登録日時を強制
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedAt == request.time

        // 更新者・更新日時も初回時点から保持
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      // enabled の切替のみ許可。
      // personId / addedAt / addedByUid は変更不可。
      allow update:
        if isActiveMealStaff()

        && request.resource.data.keys().hasAll([
          'personId',
          'enabled',
          'addedAt',
          'addedByUid',
          'updatedAt',
          'updatedByUid'
        ])

        && request.resource.data.keys().hasOnly([
          'personId',
          'enabled',
          'addedAt',
          'addedByUid',
          'updatedAt',
          'updatedByUid'
        ])

        // Identity / initial audit fields are immutable
        && request.resource.data.personId == personId
        && request.resource.data.personId == resource.data.personId
        && request.resource.data.addedAt == resource.data.addedAt
        && request.resource.data.addedByUid == resource.data.addedByUid

        // enabled / update audit fields だけ変更可
        && request.resource.data          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'enabled',
            'updatedAt',
            'updatedByUid'
          ])

        && request.resource.data.enabled is bool
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      // 履歴保持のため物理削除は禁止
      allow delete:
        if false;
    }

// ============================================================
// SeedStudio Posting
// Phase 4 - Posting masters
// ============================================================


// ------------------------------------------------------------
// Posting staff master
//
// postingStaff/{staffId}
//
// Fields:
//   staffId
//   name
//   active
//   displayOrder
//   createdAt
//   createdByUid
//   updatedAt
//   updatedByUid
// ------------------------------------------------------------

match /postingStaff/{staffId} {

  // SeedStudioの有効な admin / support は参照可能
  allow get, list:
    if isActiveMealStaff();


  // 新規作成は admin のみ
  allow create:
    if isActiveAdmin()

    && request.resource.data.keys().hasAll([
      'staffId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    && request.resource.data.keys().hasOnly([
      'staffId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    // Document ID と staffId は一致必須
    && request.resource.data.staffId == staffId

    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100

    && request.resource.data.active is bool

    && request.resource.data.displayOrder is int
    && request.resource.data.displayOrder >= 0

    // 作成者
    && request.resource.data.createdByUid == request.auth.uid
    && request.resource.data.updatedByUid == request.auth.uid

    // serverTimestamp() を使用
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;


  // 更新は admin のみ
  allow update:
    if isActiveAdmin()

    && request.resource.data.keys().hasAll([
      'staffId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    && request.resource.data.keys().hasOnly([
      'staffId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    // IDは変更不可
    && request.resource.data.staffId == staffId
    && request.resource.data.staffId == resource.data.staffId

    // 作成情報は変更不可
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdByUid == resource.data.createdByUid

    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100

    && request.resource.data.active is bool

    && request.resource.data.displayOrder is int
    && request.resource.data.displayOrder >= 0

    // 更新者・更新日時
    && request.resource.data.updatedByUid == request.auth.uid
    && request.resource.data.updatedAt == request.time

    // 更新可能フィールドを限定
    && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'name',
          'active',
          'displayOrder',
          'updatedAt',
          'updatedByUid'
        ]);


  // 過去履歴との整合性維持のため物理削除は禁止
  allow delete:
    if false;
}



// ------------------------------------------------------------
// Posting flyer master
//
// postingFlyers/{flyerId}
//
// Fields:
//   flyerId
//   name
//   active
//   displayOrder
//   createdAt
//   createdByUid
//   updatedAt
//   updatedByUid
// ------------------------------------------------------------

match /postingFlyers/{flyerId} {

  // SeedStudioの有効な admin / support は参照可能
  allow get, list:
    if isActiveMealStaff();


  // 新規作成は admin のみ
  allow create:
    if isActiveAdmin()

    && request.resource.data.keys().hasAll([
      'flyerId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    && request.resource.data.keys().hasOnly([
      'flyerId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    // Document ID と flyerId は一致必須
    && request.resource.data.flyerId == flyerId

    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 200

    && request.resource.data.active is bool

    && request.resource.data.displayOrder is int
    && request.resource.data.displayOrder >= 0

    // 作成者
    && request.resource.data.createdByUid == request.auth.uid
    && request.resource.data.updatedByUid == request.auth.uid

    // serverTimestamp() を使用
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;


  // 更新は admin のみ
  allow update:
    if isActiveAdmin()

    && request.resource.data.keys().hasAll([
      'flyerId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    && request.resource.data.keys().hasOnly([
      'flyerId',
      'name',
      'active',
      'displayOrder',
      'createdAt',
      'createdByUid',
      'updatedAt',
      'updatedByUid'
    ])

    // IDは変更不可
    && request.resource.data.flyerId == flyerId
    && request.resource.data.flyerId == resource.data.flyerId

    // 作成情報は変更不可
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.createdByUid == resource.data.createdByUid

    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 200

    && request.resource.data.active is bool

    && request.resource.data.displayOrder is int
    && request.resource.data.displayOrder >= 0

    // 更新者・更新日時
    && request.resource.data.updatedByUid == request.auth.uid
    && request.resource.data.updatedAt == request.time

    // 更新可能フィールドを限定
    && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'name',
          'active',
          'displayOrder',
          'updatedAt',
          'updatedByUid'
        ]);


  // 過去履歴との整合性維持のため物理削除は禁止
  allow delete:
    if false;
}


    match /{document=**} {
      allow read, write: if false;
    }
  }
}