  function valid(d) {
    return demoPermitted()
      ? demoValid(d)
      : liveValid(d);
  }

  function linked(d) {
    let path =
      /databases/$(database)/documents/dailyTimeDemoRecords/$(recordId)/history/$(d.operationId);

    return !exists(path)
      && getAfter(path).data == d;
  }

  allow get: if demoPermitted()
    || liveRead(recordId);

  allow list, delete: if false;

  allow create: if valid(request.resource.data)
    && request.resource.data.version == 1
    && request.resource.data.reason == ''
    && linked(request.resource.data);

  allow update: if valid(request.resource.data)
    && request.resource.data.version
       == resource.data.version + 1
    && (
      request.resource.data.start
        != resource.data.start
      || request.resource.data.end
        != resource.data.end
      || request.resource.data.attendanceVersion
        != resource.data.attendanceVersion
    )
    && (
      (
        request.resource.data.start
          != resource.data.start
        || (
          resource.data.end != ''
          && request.resource.data.end
             != resource.data.end
        )
        || request.resource.data.attendanceVersion
          != resource.data.attendanceVersion
      )
      ? request.resource.data.reason.matches(
          '(?s).*[^\\s].*'
        )
      : request.resource.data.reason == ''
    )
    && linked(request.resource.data);

  match /history/{operationId} {
    function linkedParent() {
      let path =
        /databases/$(database)/documents/dailyTimeDemoRecords/$(recordId);

      let next =
        getAfter(path).data;

      return request.resource.data == next
        && next.operationId == operationId
        && next.actor == request.auth.uid
        && next.updatedAt == request.time
        && (
