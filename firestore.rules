rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    function isActiveMealStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'support'];
    }

    // ============================================================
    // SeedStudio Staff Shift - merged production block
    // ============================================================
    // ============================================================
    // SeedStudio Shift - Firestore Security Rules v0.2
    //
    // MEMBER:
    //   owns Submission / Request facts
    //
    // MANAGER:
    //   owns Adjustment / StaffSettings facts
    //
    // Trusted Server:
    //   owns Month workflow / Confirmed Versions / Notifications
    //
    // Confirmed data is never client-writable.
    // ============================================================


    // ============================================================
    // Authentication / Identity
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function authIdentityExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/authIdentities/$(request.auth.uid)
        );
    }

    function currentPersonId() {
      return get(
        /databases/$(database)/documents/authIdentities/$(request.auth.uid)
      ).data.personId;
    }

    function isSelf(personId) {
      return signedIn()
        && authIdentityExists()
        && currentPersonId() == personId;
    }


    // ============================================================
    // Shift Membership
    // ============================================================

    function membershipId(siteId, personId) {
      return siteId + "_" + personId;
    }

    function shiftMembershipExists(siteId, personId) {
      return exists(
        /databases/$(database)/documents/shiftMemberships/$(membershipId(siteId, personId))
      );
    }

    function shiftMembership(siteId, personId) {
      return get(
        /databases/$(database)/documents/shiftMemberships/$(membershipId(siteId, personId))
      ).data;
    }

    function isActiveShiftTarget(siteId, personId) {
      return shiftMembershipExists(siteId, personId)
        && shiftMembership(siteId, personId).active == true
        && (
          shiftMembership(siteId, personId).role == "MEMBER"
          || shiftMembership(siteId, personId).role == "MANAGER"
        );
    }

    function isShiftTargetOnDate(siteId, personId, workDate) {
      let membership = shiftMembership(siteId, personId);

      return isActiveShiftTarget(siteId, personId)
        && validDate(workDate)
        && (
          !membership.keys().hasAny(["targetFrom"])
          || (
            validDate(membership.targetFrom)
            && membership.targetFrom <= workDate
          )
        )
        && (
          !membership.keys().hasAny(["targetUntil"])
          || membership.targetUntil == null
          || (
            validDate(membership.targetUntil)
            && workDate <= membership.targetUntil
          )
        );
    }

    function isShiftMember(siteId) {
      return signedIn()
        && authIdentityExists()
        && isActiveShiftTarget(siteId, currentPersonId());
    }

    function isShiftManager(siteId) {
      return isShiftMember(siteId)
        && shiftMembership(siteId, currentPersonId()).role == "MANAGER";
    }


    // ============================================================
    // Shift Month
    // ============================================================

    function shiftMonthExists(monthId) {
      return exists(
        /databases/$(database)/documents/shiftMonths/$(monthId)
      );
    }

    function shiftMonth(monthId) {
      return get(
        /databases/$(database)/documents/shiftMonths/$(monthId)
      ).data;
    }

    function monthSiteId(monthId) {
      return shiftMonth(monthId).siteId;
    }

    function isRequestOpen(monthId) {
      return shiftMonthExists(monthId)
        && shiftMonth(monthId).status == "REQUEST_OPEN"
        && shiftMonth(monthId).requestDeadline is timestamp
        && request.time <= shiftMonth(monthId).requestDeadline;
    }


    // ============================================================
    // Generic validators
    // ============================================================

    function isNullableString(value) {
      return value == null || value is string;
    }

    function validRequestType(value) {
      return value == "WORK"
        || value == "FLEXIBLE"
        || value == "OFF";
    }

    function validDecision(value) {
      return value == "WORK"
        || value == "OFF";
    }

    function validPatternType(value) {
      return value == "FIXED"
        || value == "STANDARD"
        || value == "FLEXIBLE";
    }

    function validYearMonth(value) {
      return value is string
        && value.matches(
          '[0-9]{4}-(0[1-9]|1[0-2])'
        );
    }

    function validDate(value) {
      return value is string
        && value.matches(
          '[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'
        );
    }

    function dateBelongsToYearMonth(date, yearMonth) {
      return validDate(date)
        && validYearMonth(yearMonth)
        && date[0:7] == yearMonth;
    }

    function isWorkDateInMonth(monthId, workDate) {
      return shiftMonthExists(monthId)
        && dateBelongsToYearMonth(
          workDate,
          shiftMonth(monthId).yearMonth
        );
    }


    // ------------------------------------------------------------
    // Time format:
    // 00:00 - 23:59
    // ------------------------------------------------------------

    function validTime(value) {
      return value is string
        && value.matches(
          '([01][0-9]|2[0-3]):[0-5][0-9]'
        );
    }

    function validTimeRange(start, end) {
      return validTime(start)
        && validTime(end)
        && start < end;
    }

    function validNullableTimeRange(start, end) {
      return (
        start == null
        && end == null
      )
      ||
      validTimeRange(start, end);
    }


    // ------------------------------------------------------------
    // Work days
    //
    // SeedStudio is Mon-Fri operation in Shift v1.
    // Duplicate weekdays are also rejected.
    // ------------------------------------------------------------

    function validWorkDays(days) {
      return days is list
        && days.hasOnly([
          "MON",
          "TUE",
          "WED",
          "THU",
          "FRI"
        ])
        && days.size() == days.toSet().size();
    }


    // ------------------------------------------------------------
    // Staff setting validation
    // ------------------------------------------------------------

    function validStaffSettingTimes(data) {
      return (
        (
          data.patternType == "FIXED"
          || data.patternType == "STANDARD"
        )
        && validTimeRange(
          data.defaultStart,
          data.defaultEnd
        )
      )
      ||
      (
        data.patternType == "FLEXIBLE"
        && validNullableTimeRange(
          data.defaultStart,
          data.defaultEnd
        )
      );
    }


    // ------------------------------------------------------------
    // Request time validation
    // ------------------------------------------------------------

    function validRequestTimes(data) {
      return (
        data.requestType == "WORK"
        && validTimeRange(
          data.requestedStart,
          data.requestedEnd
        )
      )
      ||
      (
        data.requestType == "OFF"
        && data.requestedStart == null
        && data.requestedEnd == null
      )
      ||
      (
        data.requestType == "FLEXIBLE"
        && validNullableTimeRange(
          data.requestedStart,
          data.requestedEnd
        )
      );
    }


    // ------------------------------------------------------------
    // Adjustment time validation
    // ------------------------------------------------------------

    function validAdjustmentTimes(data) {
      return (
        data.decision == "WORK"
        && validTimeRange(
          data.adjustedStart,
          data.adjustedEnd
        )
      )
      ||
      (
        data.decision == "OFF"
        && data.adjustedStart == null
        && data.adjustedEnd == null
      );
    }


    // ============================================================
    // Platform Core
    // ============================================================

    match /persons/{personId} {
      allow get: if isSelf(personId);
      allow list: if false;

      allow create, update, delete: if false;
    }


    match /authIdentities/{uid} {
      allow get: if signedIn()
        && request.auth.uid == uid;

      allow list: if false;

      allow create, update, delete: if false;
    }


    match /sites/{siteId} {

      allow get: if isShiftMember(siteId);
      allow list: if false;

      allow create, update, delete: if false;


      match /businessDays/{date} {

        allow get, list: if isShiftMember(siteId);

        allow create, update, delete: if false;
      }
    }


    // ============================================================
    // Shift Membership
    // ============================================================

    match /shiftMemberships/{membershipDocId} {

      allow get: if signedIn()
        && authIdentityExists()
        && (
          resource.data.personId == currentPersonId()
          || isShiftManager(resource.data.siteId)
        );

      // MANAGER queries must be constrained to their site.
      allow list: if signedIn()
        && authIdentityExists()
        && resource.data.siteId is string
        && isShiftManager(resource.data.siteId);

      // Security administration is Server-only.
      allow create, update, delete: if false;
    }


    // ============================================================
    // Shift Staff Settings
    // ============================================================

    match /shiftStaffSettings/{settingsId} {

      allow get, list, create, update, delete: if false;


      match /versions/{effectiveFrom} {

        allow get, list: if signedIn()
          && authIdentityExists()
          && (
            (
              resource.data.personId == currentPersonId()
              && isShiftMember(resource.data.siteId)
            )
            ||
            isShiftManager(resource.data.siteId)
          );


        allow create: if signedIn()
          && authIdentityExists()

          && request.resource.data.keys().hasAll([
            "siteId",
            "personId",
            "effectiveFrom",
            "patternType",
            "defaultStart",
            "defaultEnd",
            "workDays",
            "targetDaysPerWeek",
            "createdByPersonId",
            "createdAt"
          ])

          && request.resource.data.keys().hasOnly([
            "siteId",
            "personId",
            "effectiveFrom",
            "patternType",
            "defaultStart",
            "defaultEnd",
            "workDays",
            "targetDaysPerWeek",
            "createdByPersonId",
            "createdAt"
          ])

          && request.resource.data.siteId is string
          && request.resource.data.personId is string

          && isShiftManager(
            request.resource.data.siteId
          )

          // Deterministic parent ID.
          && settingsId
            == request.resource.data.siteId
              + "_"
              + request.resource.data.personId

          // Version ID / effectiveFrom consistency.
          && request.resource.data.effectiveFrom
            == effectiveFrom

          && validDate(
            request.resource.data.effectiveFrom
          )

          // StaffSettings may only begin while the staff member
          // is a dated Shift Target.
          && isShiftTargetOnDate(
            request.resource.data.siteId,
            request.resource.data.personId,
            request.resource.data.effectiveFrom
          )

          && validPatternType(
            request.resource.data.patternType
          )

          && validStaffSettingTimes(
            request.resource.data
          )

          && validWorkDays(
            request.resource.data.workDays
          )

          && request.resource.data.targetDaysPerWeek is int
          && request.resource.data.targetDaysPerWeek >= 0
          && request.resource.data.targetDaysPerWeek <= 5

          // Forced audit fields.
          && request.resource.data.createdByPersonId
            == currentPersonId()

          && request.resource.data.createdAt
            == request.time;


        // Version history is immutable.
        allow update, delete: if false;
      }
    }


    // ============================================================
    // Shift Months
    // ============================================================

    match /shiftMonths/{monthId} {

      allow get, list: if signedIn()
        && authIdentityExists()
        && resource.data.siteId is string
        && isShiftMember(resource.data.siteId);

      // Shift Confirmation Architecture v1.0 = B
      //
      // createShiftMonth(), confirmShiftMonth(), version changes,
      // deadline changes etc. are Trusted Server operations.
      allow create, update, delete: if false;


      // ==========================================================
      // Submission
      // ==========================================================

      match /submissions/{personId} {

        allow get: if shiftMonthExists(monthId)
          && (
            (
              isSelf(personId)
              && isShiftMember(monthSiteId(monthId))
            )
            ||
            isShiftManager(monthSiteId(monthId))
          );

        allow list: if shiftMonthExists(monthId)
          && isShiftManager(monthSiteId(monthId));


        allow create: if shiftMonthExists(monthId)
          && isSelf(personId)
          && isShiftMember(monthSiteId(monthId))
          && isRequestOpen(monthId)

          && request.resource.data.keys().hasAll([
            "personId",
            "status",
            "submittedAt",
            "lastUpdatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "personId",
            "status",
            "submittedAt",
            "lastUpdatedAt"
          ])

          && request.resource.data.personId
            == currentPersonId()

          && (
            (
              request.resource.data.status == "DRAFT"
              && request.resource.data.submittedAt == null
            )
            ||
            (
              request.resource.data.status == "SUBMITTED"
              && request.resource.data.submittedAt == request.time
            )
          )

          && request.resource.data.lastUpdatedAt
            == request.time;


        allow update: if shiftMonthExists(monthId)
          && isSelf(personId)
          && isShiftMember(monthSiteId(monthId))
          && isRequestOpen(monthId)

          // Owner is immutable.
          && request.resource.data.personId
            == resource.data.personId

          && request.resource.data.personId
            == currentPersonId()

          // Only these fields may change.
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "submittedAt",
              "lastUpdatedAt"
            ])

          // Allowed transitions:
          //
          // DRAFT -> DRAFT
          // DRAFT -> SUBMITTED
          // SUBMITTED -> SUBMITTED
          //
          // SUBMITTED -> DRAFT = DENY
          && (
            (
              resource.data.status == "DRAFT"
              && request.resource.data.status == "DRAFT"
              && request.resource.data.submittedAt == null
            )
            ||
            (
              resource.data.status == "DRAFT"
              && request.resource.data.status == "SUBMITTED"
              && request.resource.data.submittedAt == request.time
            )
            ||
            (
              resource.data.status == "SUBMITTED"
              && request.resource.data.status == "SUBMITTED"
              && request.resource.data.submittedAt
                == resource.data.submittedAt
            )
          )

          && request.resource.data.lastUpdatedAt
            == request.time;

        allow delete: if false;
      }


      // ==========================================================
      // Request
      // ==========================================================

      match /requests/{requestId} {

        allow get: if shiftMonthExists(monthId)
          && (
            (
              isSelf(resource.data.personId)
              && isShiftMember(monthSiteId(monthId))
            )
            ||
            isShiftManager(monthSiteId(monthId))
          );


        // MEMBER query:
        //   where("personId", "==", currentPersonId)
        //
        // MANAGER:
        //   may query the whole month.
        allow list: if shiftMonthExists(monthId)
          && (
            (
              isSelf(resource.data.personId)
              && isShiftMember(monthSiteId(monthId))
            )
            ||
            isShiftManager(monthSiteId(monthId))
          );


        allow create: if shiftMonthExists(monthId)
          && isShiftMember(monthSiteId(monthId))
          && isRequestOpen(monthId)

          && request.resource.data.keys().hasAll([
            "personId",
            "workDate",
            "requestType",
            "requestedStart",
            "requestedEnd",
            "note",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "personId",
            "workDate",
            "requestType",
            "requestedStart",
            "requestedEnd",
            "note",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.personId
            == currentPersonId()

          // Deterministic Request ID.
          && requestId
            == request.resource.data.personId
              + "_"
              + request.resource.data.workDate

          // Date must belong to target month.
          && isWorkDateInMonth(
            monthId,
            request.resource.data.workDate
          )

          && validRequestType(
            request.resource.data.requestType
          )

          && validRequestTimes(
            request.resource.data
          )

          && isNullableString(
            request.resource.data.note
          )

          // Forced audit timestamps.
          && request.resource.data.createdAt
            == request.time

          && request.resource.data.updatedAt
            == request.time;


        allow update: if shiftMonthExists(monthId)
          && isShiftMember(monthSiteId(monthId))
          && isRequestOpen(monthId)

          // Ownership / identity are immutable.
          && resource.data.personId
            == currentPersonId()

          && request.resource.data.personId
            == resource.data.personId

          && request.resource.data.workDate
            == resource.data.workDate

          && request.resource.data.createdAt
            == resource.data.createdAt

          && isWorkDateInMonth(
            monthId,
            request.resource.data.workDate
          )

          // Only editable fields.
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "requestType",
              "requestedStart",
              "requestedEnd",
              "note",
              "updatedAt"
            ])

          && validRequestType(
            request.resource.data.requestType
          )

          && validRequestTimes(
            request.resource.data
          )

          && isNullableString(
            request.resource.data.note
          )

          && request.resource.data.updatedAt
            == request.time;


        allow delete: if shiftMonthExists(monthId)
          && isShiftMember(monthSiteId(monthId))
          && isRequestOpen(monthId)
          && resource.data.personId
            == currentPersonId();
      }


      // ==========================================================
      // Adjustment
      // ==========================================================

      match /adjustments/{adjustmentId} {

        allow get, list: if shiftMonthExists(monthId)
          && isShiftManager(monthSiteId(monthId));


        allow create: if shiftMonthExists(monthId)
          && isShiftManager(monthSiteId(monthId))
          && shiftMonth(monthId).status != "CONFIRMED"

          && request.resource.data.keys().hasAll([
            "siteId",
            "personId",
            "workDate",
            "decision",
            "adjustedStart",
            "adjustedEnd",
            "reason",
            "active",
            "adjustedByPersonId",
            "createdAt",
            "updatedAt",
            "appliedVersion"
          ])

          && request.resource.data.keys().hasOnly([
            "siteId",
            "personId",
            "workDate",
            "decision",
            "adjustedStart",
            "adjustedEnd",
            "reason",
            "active",
            "adjustedByPersonId",
            "createdAt",
            "updatedAt",
            "appliedVersion"
          ])

          && request.resource.data.siteId
            == monthSiteId(monthId)

          && request.resource.data.personId is string

          // Target must be eligible on this workDate.
          && isShiftTargetOnDate(
            monthSiteId(monthId),
            request.resource.data.personId,
            request.resource.data.workDate
          )

          && isWorkDateInMonth(
            monthId,
            request.resource.data.workDate
          )

          && validDecision(
            request.resource.data.decision
          )

          && validAdjustmentTimes(
            request.resource.data
          )

          && isNullableString(
            request.resource.data.reason
          )

          && request.resource.data.active is bool

          // Forced actor.
          && request.resource.data.adjustedByPersonId
            == currentPersonId()

          // Forced audit timestamps.
          && request.resource.data.createdAt
            == request.time

          && request.resource.data.updatedAt
            == request.time

          // Only Trusted Server may apply an Adjustment
          // to a confirmed version.
          && request.resource.data.appliedVersion
            == null;


        allow update: if shiftMonthExists(monthId)
          && isShiftManager(monthSiteId(monthId))
          && shiftMonth(monthId).status != "CONFIRMED"

          // Once applied, completely frozen.
          && resource.data.appliedVersion == null
          && request.resource.data.appliedVersion == null

          // Identity fields are immutable.
          && request.resource.data.siteId
            == resource.data.siteId

          && request.resource.data.personId
            == resource.data.personId

          && request.resource.data.workDate
            == resource.data.workDate

          && request.resource.data.adjustedByPersonId
            == resource.data.adjustedByPersonId

          && request.resource.data.createdAt
            == resource.data.createdAt

          // Target must still belong to this site.
          && request.resource.data.siteId
            == monthSiteId(monthId)

          && isShiftTargetOnDate(
            monthSiteId(monthId),
            request.resource.data.personId,
            request.resource.data.workDate
          )

          && isWorkDateInMonth(
            monthId,
            request.resource.data.workDate
          )

          // Editable fields only.
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "decision",
              "adjustedStart",
              "adjustedEnd",
              "reason",
              "active",
              "updatedAt"
            ])

          && validDecision(
            request.resource.data.decision
          )

          && validAdjustmentTimes(
            request.resource.data
          )

          && isNullableString(
            request.resource.data.reason
          )

          && request.resource.data.active is bool

          && request.resource.data.updatedAt
            == request.time;

        // Never physically delete manager history.
        allow delete: if false;
      }


      // ==========================================================
      // Confirmed Shift Versions
      // ==========================================================

      match /versions/{versionId} {

        allow get, list: if shiftMonthExists(monthId)
          && isShiftMember(monthSiteId(monthId));

        // Trusted Server only.
        allow create, update, delete: if false;


        match /entries/{entryId} {

          allow get, list: if shiftMonthExists(monthId)
            && (
              (
                isSelf(resource.data.personId)
                && isShiftMember(monthSiteId(monthId))
              )
              ||
              isShiftManager(monthSiteId(monthId))
            );

          // Trusted Server only.
          allow create, update, delete: if false;
        }
      }


      // ==========================================================
      // Notification History
      // ==========================================================

      match /notifications/{notificationId} {

        allow get, list: if shiftMonthExists(monthId)
          && isShiftManager(monthSiteId(monthId));

        // Trusted Server only.
        allow create, update, delete: if false;
      }
    }
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /connectionTests/{uid} {
      allow get: if isActiveAdmin() && request.auth.uid == uid;
      allow create, update: if isActiveAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['message', 'savedAt'])
        && request.resource.data.keys().hasOnly(['message', 'savedAt'])
        && request.resource.data.message == 'save-test-ok'
        && request.resource.data.savedAt == request.time;
      allow list, delete: if false;
    }
    match /mealDemoRecords/{recordId} {
      function demoAdmin() {
        return (recordId in ['demo-2026-10-02', 'batch02-2026-10-02', 'batch03-2026-10-02'] || recordId.matches('^bulk(0[1-9]|[12][0-9]|3[0-2])-2026-10-02$')) && isActiveMealStaff();
      }
      function validRecord(data) {
        return data.keys().hasAll(['food','version','reason','actor','updatedAt','operationId'])
          && data.keys().hasOnly(['food','version','reason','actor','updatedAt','operationId'])
          && data.food in ['provided','none']
          && data.version is int && data.version > 0
          && data.reason is string && data.reason.size() <= 200
          && data.actor == request.auth.uid && data.updatedAt == request.time
          && data.operationId is string && data.operationId.matches('^[a-zA-Z0-9-]{1,80}$');
      }
      function linkedAudit(data, before) {
        let path = /databases/$(database)/documents/mealDemoRecords/$(recordId)/history/$(data.operationId);
        let audit = getAfter(path).data;
        return !exists(path)
          && audit.food == data.food && audit.version == data.version
          && audit.reason == data.reason && audit.actor == data.actor
          && audit.updatedAt == data.updatedAt && audit.operationId == data.operationId
          && audit.before == before;
      }
      allow get: if demoAdmin();
      allow list, delete: if false;
      allow create: if demoAdmin() && validRecord(request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.reason == ''
        && linkedAudit(request.resource.data, 'unentered');
      allow update: if demoAdmin() && validRecord(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.food != resource.data.food
        && request.resource.data.reason.matches('.*[^\\s].*')
        && linkedAudit(request.resource.data, resource.data.food);
      match /history/{operationId} {
        function validAudit() {
          let path = /databases/$(database)/documents/mealDemoRecords/$(recordId);
          let next = getAfter(path).data;
          let data = request.resource.data;
          return data.keys().hasAll(['food','version','reason','actor','updatedAt','operationId','before'])
            && data.keys().hasOnly(['food','version','reason','actor','updatedAt','operationId','before'])
            && data.operationId == operationId && next.operationId == operationId
            && data.food == next.food && data.version == next.version
