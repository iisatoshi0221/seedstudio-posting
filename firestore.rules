  }

  function liveValid(d) {
    return d.keys().hasAll([
        'date',
        'userId',
        'start',
        'end',
        'attendanceVersion',
        'reason',
        'version',
        'actor',
        'updatedAt',
        'operationId'
      ])
      && d.keys().hasOnly([
        'date',
        'userId',
        'start',
        'end',
        'attendanceVersion',
        'reason',
        'version',
        'actor',
        'updatedAt',
        'operationId'
      ])
      && d.date is string
      && d.userId is string
      && d.start is string
      && d.start.matches(
        '^(10|11|12|13|14|15):[0-5][0-9]$'
      )
      && d.start >= '10:30'
      && d.start < '15:30'
      && d.end is string
      && (
        d.end == ''
        || (
          d.end.matches(
            '^(10|11|12|13|14|15):[0-5][0-9]$'
          )
          && d.end > d.start && d.end <= '15:30'
        )
      )
      && d.attendanceVersion is int
      && d.attendanceVersion > 0
      && d.reason is string
      && d.reason.size() <= 200
      && d.version is int
      && d.version > 0
      && d.actor == request.auth.uid
      && d.updatedAt == request.time
      && d.operationId is string
      && d.operationId.matches(
        '^[a-zA-Z0-9-]{1,80}$'
      )
      && livePermitted(d)
      && getAfter(
        /databases/$(database)/documents/attendanceDemoRecords/$(recordId)
      ).data.attendance in ['onsite','home']
