    match /transferDemoRecords/{recordId} {
      function permitted() {
        return recordId.matches('^bulk(0[1-9]|[12][0-9]|3[0-6])-2026-10-02$') && isActiveMealStaff();
      }
      function sourcesMatch(v) {
        return v.keys().hasAll(['start','end','meal','note','am','pm'])
          && v.keys().hasOnly(['start','end','meal','note','am','pm'])
          && v.start == getAfter(/databases/$(database)/documents/startDemoRecords/$(recordId)).data.version
          && v.end == getAfter(/databases/$(database)/documents/endDemoRecords/$(recordId)).data.version
          && v.note == getAfter(/databases/$(database)/documents/noteDemoRecords/$(recordId)).data.version
          && (recordId.matches('^bulk3[3-6]-2026-10-02$')
            ? (v.meal == 0 && v.am == 0 && v.pm == 0)
            : (v.meal == getAfter(/databases/$(database)/documents/mealDemoRecords/$(recordId)).data.version
              && v.am == getAfter(/databases/$(database)/documents/transportDemoRecords/$(recordId + '-am')).data.version
              && v.pm == getAfter(/databases/$(database)/documents/transportDemoRecords/$(recordId + '-pm')).data.version));
      }
      function valid(data) {
        return data.keys().hasAll(['versions','version','state','reason','actor','updatedAt','operationId'])
          && data.keys().hasOnly(['versions','version','state','reason','actor','updatedAt','operationId'])
          && data.version is int && data.version > 0 && data.versions is map
          && data.actor == request.auth.uid && data.updatedAt == request.time
          && data.operationId is string && data.operationId.matches('^[a-zA-Z0-9-]{1,80}$')
          && data.state in ['confirmed','cancelled'] && data.reason is string && data.reason.size() <= 200;
