    // v0.9 real-user attendance. Legacy demo permissions above remain unchanged.
    function isActiveStaff() { return isActiveMealStaff(); }
    function liveCalendarParts(parts) {
      let y = int(parts[0]);
      let m = int(parts[1]);
      let d = int(parts[2]);
      let leap = y % 400 == 0 || (y % 4 == 0 && y % 100 != 0);
      let days = m == 2 ? (leap ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31);
      return y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= days;
    }
    function liveDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && liveCalendarParts(value.split('-'));
    }
    function liveNotFuture(date) {
      let p = date.split('-');
      return timestamp.date(int(p[0]),int(p[1]),int(p[2])) <= (request.time + duration.value(9,'h')).date();
    }
    function liveTarget(userId,date) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      let b = get(/databases/$(database)/documents/businessDays/$(date)).data;
      return userId.matches('^U[0-9]{4}$') && liveDate(date)
        && u.keys().hasAll(['userId','name','active','startDate','endDate'])
        && u.userId == userId && u.name is string && u.name.matches('(?s).*[^\\s].*') && u.active is bool
        && liveDate(u.startDate) && u.startDate <= date
        && (u.endDate == null || (liveDate(u.endDate) && u.startDate <= u.endDate && date <= u.endDate))
        && b.date == date && b.open == true && (!('note' in b) || b.note is string);
    }
    function liveKey(recordId) { return recordId.matches('^U[0-9]{4}-[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function liveRead(recordId) {
      let p = recordId.split('-');
      return isActiveStaff() && liveKey(recordId) && liveTarget(p[0],p[1]+'-'+p[2]+'-'+p[3]);
    }


	match /users/{userId} {
	  allow read: if isActiveStaff();
	  allow write: if false;
	}


    match /businessDays/{date} {
      allow read: if isActiveStaff();
      allow write: if false;
    }
    // Read-only probes required by the attendance transaction, including missing records.
    // Do not enable real-user meal/time/note writes in this release.
    match /{relatedCollection}/{recordId} {
      allow get: if relatedCollection in ['dailyMealDemoRecords','dailyTimeDemoRecords','dailyNoteDemoRecords'] && liveRead(recordId);
    }
    match /attendanceDemoRecords/{recordId} {
      function validLive(d) {
        return liveKey(recordId)
          && d.keys().hasAll(['date','userId','attendance','reason','version','actor','updatedAt','operationId'])
          && d.keys().hasOnly(['date','userId','attendance','reason','version','actor','updatedAt','operationId'])
          && d.userId is string && liveTarget(d.userId,d.date)
          && recordId == d.userId + '-' + d.date
          && d.attendance in ['unknown','onsite','home','absent']
          && d.reason is string && d.reason.size() <= 200
          && d.version is int && d.version > 0 && d.actor == request.auth.uid && d.updatedAt == request.time
          && d.operationId is string && d.operationId.matches('^[a-zA-Z0-9-]{1,80}$');
      }
      function safeLive(d) {
        return (d.attendance == 'onsite' || !existsAfter(/databases/$(database)/documents/dailyMealDemoRecords/$(recordId)))
          && (d.attendance in ['onsite','home'] ||
            (!existsAfter(/databases/$(database)/documents/dailyTimeDemoRecords/$(recordId))
            && !existsAfter(/databases/$(database)/documents/dailyNoteDemoRecords/$(recordId))));
      }
      function linkedLive(d) {
        let path = /databases/$(database)/documents/attendanceDemoRecords/$(recordId)/history/$(d.operationId);
        return !exists(path) && getAfter(path).data == d;
      }
      allow get: if liveRead(recordId);
      allow create: if isActiveStaff() && validLive(request.resource.data)
	&& liveNotFuture(request.resource.data.date)
	&& request.resource.data.version == 1 && request.resource.data.reason == ''
	&& request.resource.data.attendance != 'unknown' && safeLive(request.resource.data) && linkedLive(request.resource.data);
      allow update: if isActiveStaff() && validLive(request.resource.data)
	&& liveNotFuture(request.resource.data.date)
	&& request.resource.data.version == resource.data.version + 1
	&& request.resource.data.attendance != resource.data.attendance
	&& request.resource.data.reason.matches('(?s).*[^\\s].*')
	&& safeLive(request.resource.data) && linkedLive(request.resource.data);
      match /history/{operationId} {
        function linkedLiveParent() {
          let path = /databases/$(database)/documents/attendanceDemoRecords/$(recordId);
          let next = getAfter(path).data;
          return request.resource.data == next && next.operationId == operationId
            && next.actor == request.auth.uid && next.updatedAt == request.time
            && ((!exists(path) && next.version == 1)
              || (exists(path) && next.version == get(path).data.version + 1));
        }
        allow read: if liveRead(recordId);
        allow create: if liveRead(recordId) && linkedLiveParent();
        allow update, delete: if false;
      }
    }

    match /dailyMealDemoRecords/{recordId} {
      function demoPermitted() {
        return isActiveMealStaff()
          && recordId.matches('^bulk(0[1-9]|[1-3][0-9]|40)-2026-10-(02|05)$');
      }

      function livePermitted(d) {
        return isActiveMealStaff()
          && recordId == d.userId + '-' + d.date
          && d.userId.matches('^U[0-9]{4}$')
          && liveDate(d.date)
          && liveNotFuture(d.date)
          && liveTarget(d.userId, d.date);
      }

      function demoValid(d) {
        return d.keys().hasAll([
            'date',
            'userId',
            'food',
            'attendanceVersion',
            'reason',
            'version',
            'actor',
            'updatedAt',
            'operationId'
          ])
          && d.keys().hasOnly([
            'date',
            'userId',
            'food',
            'attendanceVersion',
            'reason',
            'version',
            'actor',
            'updatedAt',
            'operationId'
          ])
          && d.date in ['2026-10-02','2026-10-05']
          && d.userId is string
          && d.userId.matches('^bulk(0[1-9]|[1-3][0-9]|40)$')
          && recordId == d.userId + '-' + d.date
          && d.food in ['provided','none']
          && d.attendanceVersion is int
          && d.attendanceVersion > 0
          && getAfter(
            /databases/$(database)/documents/attendanceDemoRecords/$(recordId)
          ).data.attendance == 'onsite'
          && getAfter(
            /databases/$(database)/documents/attendanceDemoRecords/$(recordId)
          ).data.version == d.attendanceVersion
          && d.reason is string
          && d.reason.size() <= 200
          && d.version is int
          && d.version > 0
          && d.actor == request.auth.uid
          && d.updatedAt == request.time
          && d.operationId is string
          && d.operationId.matches('^[a-zA-Z0-9-]{1,80}$');
      }

      function liveValid(d) {
        return d.keys().hasAll([
            'date',
            'userId',
            'food',
            'attendanceVersion',
            'reason',
            'version',
            'actor',
            'updatedAt',
            'operationId'
          ])
          && d.keys().hasOnly([
            'date',
            'userId',
            'food',
            'attendanceVersion',
            'reason',
            'version',
            'actor',
            'updatedAt',
            'operationId'
          ])
          && d.date is string
          && d.userId is string
          && d.food in ['provided','none']
          && d.attendanceVersion is int
          && d.attendanceVersion > 0
          && d.reason is string
          && d.reason.size() <= 200
          && d.version is int
          && d.version > 0
          && d.actor == request.auth.uid
          && d.updatedAt == request.time
          && d.operationId is string
          && d.operationId.matches('^[a-zA-Z0-9-]{1,80}$')
          && livePermitted(d)
          && getAfter(
            /databases/$(database)/documents/attendanceDemoRecords/$(recordId)
          ).data.attendance == 'onsite'
          && getAfter(
            /databases/$(database)/documents/attendanceDemoRecords/$(recordId)
          ).data.version == d.attendanceVersion;
      }

      function valid(d) {
        return demoPermitted()
          ? demoValid(d)
          : liveValid(d);
      }



      function linked(d) {
        let path =
          /databases/$(database)/documents/dailyMealDemoRecords/$(recordId)/history/$(d.operationId);

        return !exists(path)
          && getAfter(path).data == d;
      }

      allow get: if demoPermitted() || liveRead(recordId);
      allow list, delete: if false;


	allow create: if valid(request.resource.data)
	  && request.resource.data.version == 1
	  && request.resource.data.reason == ''
	  && linked(request.resource.data);


      allow update: if valid(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && (
          request.resource.data.food != resource.data.food
          || request.resource.data.attendanceVersion
             != resource.data.attendanceVersion
        )
        && request.resource.data.reason.matches('(?s).*[^\\s].*')
        && linked(request.resource.data);

      match /history/{operationId} {
        function linkedParent() {
          let path =
            /databases/$(database)/documents/dailyMealDemoRecords/$(recordId);

          let next = getAfter(path).data;

          return request.resource.data == next
            && next.operationId == operationId
            && next.actor == request.auth.uid
            && next.updatedAt == request.time
            && (
              (!exists(path) && next.version == 1)
              || (
                exists(path)
                && next.version == get(path).data.version + 1
              )
            );
        }


        allow read: if demoPermitted() || liveRead(recordId);

        allow create: if (demoPermitted() || liveRead(recordId))
  && linkedParent();

        allow update, delete: if false;
      }
    }
    match /dailyTimeDemoRecords/{recordId} {
  function demoPermitted() {
    return isActiveMealStaff()
      && recordId.matches(
        '^bulk(0[1-9]|[1-3][0-9]|40)-2026-10-(02|05)$'
      );
  }

  function livePermitted(d) {
    return isActiveMealStaff()
      && recordId == d.userId + '-' + d.date
      && d.userId.matches('^U[0-9]{4}$')
      && liveDate(d.date)
      && liveNotFuture(d.date)
      && liveTarget(d.userId, d.date);
  }

  function demoValid(d) {
    return d.keys().hasAll([
        'date',
        'userId',
        'start',
        'end',
        'attendanceVersion',
        'reason',
        'version',
        'actor',
        'updatedAt',
        'operationId'
      ])
      && d.keys().hasOnly([
        'date',
        'userId',
        'start',
        'end',
        'attendanceVersion',
        'reason',
        'version',
        'actor',
        'updatedAt',
        'operationId'
      ])
      && d.date in ['2026-10-02','2026-10-05']
      && d.userId is string
      && d.userId.matches(
        '^bulk(0[1-9]|[1-3][0-9]|40)$'
      )
      && recordId == d.userId + '-' + d.date
      && d.start is string
      && d.start.matches(
        '^(10|11|12|13|14|15):[0-5][0-9]$'
      )
      && d.start >= '10:30'
      && d.start < '15:30'
      && d.end is string
      && (
