            && next.version
               == get(path).data.version + 1
          )
        );
    }

    allow read: if demoPermitted()
      || liveRead(recordId);

    allow create: if (
        demoPermitted()
        || liveRead(recordId)
      )
      && linkedParent();

    allow update, delete: if false;
  }
}
